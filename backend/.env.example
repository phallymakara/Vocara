# ==============================================================================
# VOCARA API CONFIGURATION ENVIRONMENT VARIABLES
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
PROJECT_NAME="Vocara Voice API Platform"
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server
HOST=0.0.0.0
PORT=8002
WORKERS=1

# Security & Master API Key
API_KEY_SALT=change-this-salt-in-production-use-a-strong-secret
SECRET_KEY=change-this-jwt-secret-in-production

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://vocara_user:vocara_password@localhost:5432/vocara_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Redis (Caching & Job Queue)
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# Object Storage (local | azure | r2)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage_local

# Azure Blob Storage (if STORAGE_BACKEND=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=vocara-audio

# Cloudflare R2 / S3-compatible (if STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vocara-audio
R2_PUBLIC_URL_PREFIX=

# Inference Engine (fake | modal | huggingface)
INFERENCE_ENGINE_TYPE=fake
MODAL_API_ENDPOINT=
MODAL_API_TOKEN=
HUGGINGFACE_API_KEY=
HUGGINGFACE_ENDPOINT_URL=
HUGGINGFACE_MODEL_ID=openbmb/VoxCPM2
INFERENCE_TIMEOUT_SECONDS=60

# Rate Limiting & Quotas
DEFAULT_RATE_LIMIT_PER_MINUTE=60
DEFAULT_CHAR_QUOTA_PER_MONTH=100000

# Background Inference Worker
WORKER_QUEUE_NAME=jobs:inference
WORKER_POLL_TIMEOUT_SECONDS=2

# Logging (Level: DEBUG | INFO | WARNING | ERROR | CRITICAL; Format: console | json)
LOG_LEVEL=INFO
LOG_FORMAT=console

